  oa:hasBody [ a oa:TextualBody ; rdf:value "VariantType \"single nucleotide variant\" (structural kind: SNV, indel, deletion, etc.) has no v1-draft genomics: predicate. Captured in consequenceTerm only when SO mapping is present." ] ;
