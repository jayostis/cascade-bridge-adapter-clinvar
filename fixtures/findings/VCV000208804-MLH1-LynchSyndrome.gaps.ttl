@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix oa:  <http://www.w3.org/ns/oa#> .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/VCV000208804-MLH1-LynchSyndrome.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ClinVarResult-Set/VariationArchive[1]" ;
      oa:refinedBy [ a oa:XPathSelector ; rdf:value "ClassifiedRecord/SimpleAllele/OtherNameList" ]
    ]
  ] ;
  oa:hasBody [ a oa:TextualBody ; rdf:value "OtherNameList carries legacy / alias variant names (\"p.C61G:TGT>GGT\", \"300T>G\") that pre-date current HGVS conventions. No v1-draft alias-list predicate; could be added as genomics:variantAlias." ] ;
  sh:resultSeverity sh:Info .

