[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/VCV000017661-BRCA1.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ClinVarResult-Set/VariationArchive[1]" ;
      oa:refinedBy [ a oa:XPathSelector ; rdf:value "ClassifiedRecord/SimpleAllele/GeneList/Gene[1]/Haploinsufficiency" ]
    ]
  ] ;
  oa:hasBody [ a oa:TextualBody ; rdf:value "ClinGen dosage-sensitivity annotations on the Gene (Haploinsufficiency / Triplosensitivity) carry the dosage-pathogenicity evidence — not variant-level. No v1-draft Gene predicate; candidate genomics:haploinsufficiency / genomics:triplosensitivity at the Gene class level." ] ;
  sh:resultSeverity sh:Info .

