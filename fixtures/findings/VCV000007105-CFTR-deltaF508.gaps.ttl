[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/VCV000007105-CFTR-deltaF508.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ClinVarResult-Set/VariationArchive[1]" ;
