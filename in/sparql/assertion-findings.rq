PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX clinvar: <https://ns.cascadeprotocol.org/adapter/clinvar/v1-draft#>

# An assertion that yields no SubmitterAssertion still reports its SubmitterName and
# OrganizationCategory findings and the one that says why it yields none; the rest are
# reported for emitted assertions only. ?gate says which rules run for emitted
# assertions, which for skipped ones, and which for both. Each rule also binds a path
# below its ClinicalAssertion (?sfT); the record's wrapper element and the assertion
# are joined on after the UNION.
#
# Shaped for Oxigraph's join ordering as variant.rq's header describes.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?xpath ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value ;
    sh:resultSeverity ?severity .
}
WHERE {
  ?va a xyz:VariationArchive ; ?recSlot ?rec .
  ?rec a ?recType .
  FILTER(?recType = xyz:ClassifiedRecord ||
         (?recType = xyz:IncludedRecord && NOT EXISTS { ?va ?cs ?cr . ?cr a xyz:ClassifiedRecord }))
  { SELECT DISTINCT ?rec WHERE { ?rec ?alSlot ?allele . ?allele a xyz:SimpleAllele } }
  ?rec ?s1 ?cal . ?cal a xyz:ClinicalAssertionList ; ?s2 ?ca . ?ca a xyz:ClinicalAssertion .
  ?ca ?s3 ?cva . ?cva a xyz:ClinVarAccession ; xyz:Accession ?scv . FILTER(STRLEN(?scv) > 0)
  ?ca ?s4 ?cl . ?cl a xyz:Classification .
  OPTIONAL { SELECT ?cl ?cgt WHERE { ?cl ?s5 ?cg . ?cg a xyz:GermlineClassification ; rdf:_1 ?cgt . FILTER(isLiteral(?cgt)) } }
  BIND(COALESCE(LCASE(REPLACE(?cgt, "^\\s+|\\s+$", "")) IN
         ("pathogenic", "likely pathogenic", "uncertain significance", "likely benign", "benign"), false) AS ?emitted)

  OPTIONAL {
  {
    # An absence: the ClinVarAccession is the nearest element that exists.
    ?cva a xyz:ClinVarAccession .
    MINUS { ?cva xyz:SubmitterName ?sn FILTER(STRLEN(?sn) > 0) }
    BIND("/ClinVarAccession" AS ?sfT)
    BIND(clinvar:assertionWithoutSubmitterName AS ?gap)
    BIND(sh:Warning AS ?severity)
    BIND("any" AS ?gate)
  }
  UNION
  {
    ?cva a xyz:ClinVarAccession ; xyz:OrganizationCategory ?oc .
    FILTER(STRLEN(?oc) > 0 && !(LCASE(?oc) IN ("laboratory", "consortium", "expert-panel", "expert panel",
           "research group", "research", "resource", "clinician", "single clinician")))
    BIND("/ClinVarAccession/@OrganizationCategory" AS ?sfT)
    BIND(clinvar:organizationCategoryNotMapped AS ?gap)
    BIND(?oc AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("any" AS ?gate)
  }
  UNION
  {
    ?cl a xyz:Classification ; ?c1 ?rsE . ?rsE a xyz:ReviewStatus ; rdf:_1 ?rsT . FILTER(isLiteral(?rsT))
    BIND(REPLACE(?rsT, "^\\s+|\\s+$", "") AS ?rsText)
    FILTER(STRLEN(?rsText) > 0)
    BIND("/Classification/ReviewStatus" AS ?sfT)
    BIND(clinvar:assertionReviewStatus AS ?gap)
    BIND(?rsText AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    ?cl a xyz:Classification ; xyz:DateLastEvaluated ?dle . FILTER(STRLEN(?dle) > 0)
    BIND("/Classification/@DateLastEvaluated" AS ?sfT)
    BIND(clinvar:assertionEvaluationDate AS ?gap)
    BIND(?dle AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # One finding per lifecycle attribute: a selector names one node.
    ?ca a xyz:ClinicalAssertion ; ?lp ?lv .
    FILTER(?lp IN (xyz:SubmissionDate, xyz:DateCreated, xyz:DateLastUpdated) && STRLEN(?lv) > 0)
    BIND(CONCAT("/@", STRAFTER(STR(?lp), "http://sparql.xyz/facade-x/data/")) AS ?sfT)
    BIND(clinvar:submissionLifecycleDate AS ?gap)
    BIND(?lv AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # Reported once for the ClinicalAssertion when any ObservedIn/Method carries a
    # MethodType with text. The methods span the ObservedInList, which is therefore
    # what the finding selects.
    { SELECT ?ca (MAX(?has) AS ?any) WHERE {
        ?ca a xyz:ClinicalAssertion ; ?m1 ?oil . ?oil a xyz:ObservedInList ; ?m2 ?oi .
        ?oi a xyz:ObservedIn ; ?m3 ?m . ?m a xyz:Method .
        OPTIONAL { SELECT ?m ?mtt WHERE { ?m ?m4 ?mt . ?mt a xyz:MethodType .
                   OPTIONAL { ?mt rdf:_1 ?mtt . FILTER(isLiteral(?mtt)) } } }
        BIND(COALESCE(REPLACE(?mtt, "^\\s+|\\s+$", ""), "") AS ?mtv)
        BIND(IF(STRLEN(?mtv) > 0, 1, 0) AS ?has)
      } GROUP BY ?ca }
    FILTER(?any = 1)
    BIND("/ObservedInList" AS ?sfT)
    BIND(clinvar:observationMethodType AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # IDs with text, under Classification's Citations if it has any, else
    # under the assertion's own. The count is over that container, so it is what
    # the finding selects.
    { SELECT ?ca ?container (COUNT(?idt) AS ?nCit) WHERE {
        { ?ca a xyz:ClinicalAssertion ; ?c1 ?clx . ?clx a xyz:Classification ; ?c2 ?cit . ?cit a xyz:Citation
          BIND("/Classification" AS ?container) }
        UNION
        { ?ca a xyz:ClinicalAssertion ; ?c3 ?cit . ?cit a xyz:Citation .
          MINUS { ?ca ?c4 ?cly . ?cly a xyz:Classification ; ?c5 ?cit2 . ?cit2 a xyz:Citation }
          BIND("" AS ?container) }
        ?cit ?c6 ?idn . ?idn a xyz:ID ; rdf:_1 ?idt . FILTER(isLiteral(?idt))
      } GROUP BY ?ca ?container }
    FILTER(?nCit > 0)
    BIND(?container AS ?sfT)
    BIND(clinvar:assertionSupportingCitation AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    ?ca a xyz:ClinicalAssertion ; ?r1 ?rse . ?rse a xyz:RecordStatus ; rdf:_1 ?rst . FILTER(isLiteral(?rst))
    BIND(REPLACE(?rst, "^\\s+|\\s+$", "") AS ?recSt)
    FILTER(STRLEN(?recSt) > 0 && ?recSt != "current")
    BIND("/RecordStatus" AS ?sfT)
    BIND(clinvar:assertionRecordStatus AS ?gap)
    BIND(?recSt AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # Once per ObservedIn, which the selector names by position.
    ?ca a xyz:ClinicalAssertion ; ?o1 ?oil2 . ?oil2 a xyz:ObservedInList ; ?oiSlot2 ?oi2 . ?oi2 a xyz:ObservedIn ; ?o3 ?smp .
    ?smp a xyz:Sample ; ?o4 ?ase . ?ase a xyz:AffectedStatus ; rdf:_1 ?ast . FILTER(isLiteral(?ast))
    BIND(REPLACE(?ast, "^\\s+|\\s+$", "") AS ?aff)
    FILTER(STRLEN(?aff) > 0)
    BIND(CONCAT("/ObservedInList/ObservedIn[", STRAFTER(STR(?oiSlot2), "#_"), "]/Sample/AffectedStatus") AS ?sfT)
    BIND(clinvar:sampleAffectedStatus AS ?gap)
    BIND(?aff AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # Once per ObservedData, which the selector names by the position of both it and
    # its ObservedIn.
    ?ca a xyz:ClinicalAssertion ; ?o5 ?oil3 . ?oil3 a xyz:ObservedInList ; ?oiSlot3 ?oi3 .
    ?oi3 a xyz:ObservedIn ; ?odSlot ?od . ?od a xyz:ObservedData .
    { SELECT ?od (COUNT(?earlierOd) AS ?beforeOd) WHERE {
        ?ownerOd ?dA ?od . ?od a xyz:ObservedData .
        OPTIONAL { ?ownerOd ?dB ?earlierOd . ?earlierOd a xyz:ObservedData .
                   FILTER(xsd:integer(STRAFTER(STR(?dB), "#_")) < xsd:integer(STRAFTER(STR(?dA), "#_"))) }
      } GROUP BY ?od }
    BIND(CONCAT("/ObservedInList/ObservedIn[", STRAFTER(STR(?oiSlot3), "#_"),
                "]/ObservedData[", STR(?beforeOd + 1), "]") AS ?sfT)
    BIND(clinvar:observedDataEvidence AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # Once per Comment, which the selector names by position.
    ?cl a xyz:Classification ; ?k1 ?cm . ?cm a xyz:Comment .
    { SELECT ?cm (COUNT(?earlierCm) AS ?beforeCm) WHERE {
        ?ownerCm ?mA ?cm . ?cm a xyz:Comment .
        OPTIONAL { ?ownerCm ?mB ?earlierCm . ?earlierCm a xyz:Comment .
                   FILTER(xsd:integer(STRAFTER(STR(?mB), "#_")) < xsd:integer(STRAFTER(STR(?mA), "#_"))) }
      } GROUP BY ?cm }
    BIND(CONCAT("/Classification/Comment[", STR(?beforeCm + 1), "]") AS ?sfT)
    BIND(clinvar:assertionComment AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    ?ca a xyz:ClinicalAssertion ; ?d1 ?sd . ?sd a xyz:StudyDescription ; rdf:_1 ?sdt . FILTER(isLiteral(?sdt))
    BIND("/StudyDescription" AS ?sfT)
    BIND(clinvar:assertionStudyDescription AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # An absence: the ClinicalAssertion is the nearest element that exists.
    ?rec13 ?n1 ?cal13 . ?cal13 a xyz:ClinicalAssertionList ; ?n2 ?ca . ?ca a xyz:ClinicalAssertion ; xyz:ID ?tid .
    FILTER(STRLEN(?tid) > 0)
    # An anti-join as MINUS, which walks the TraitMappings once, not per assertion.
    MINUS { ?rec13 ?n3 ?tml . ?tml a xyz:TraitMappingList ; ?n4 ?tm . ?tm xyz:ClinicalAssertionID ?tid }
    BIND("" AS ?sfT)
    BIND(clinvar:assertionWithoutTraitMapping AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  UNION
  {
    # On a skipped assertion: GermlineClassification text outside the five classes.
    ?cl a xyz:Classification ; ?q1 ?cgx . ?cgx a xyz:GermlineClassification ; rdf:_1 ?cgxt . FILTER(isLiteral(?cgxt))
    BIND(REPLACE(?cgxt, "^\\s+|\\s+$", "") AS ?gText)
    FILTER(STRLEN(?gText) > 0)
    BIND("/Classification/GermlineClassification" AS ?sfT)
    BIND(clinvar:assertionClassificationOutsideAcmgSet AS ?gap)
    BIND(?gText AS ?value)
    BIND(sh:Warning AS ?severity)
    BIND("skipped" AS ?gate)
  }
  UNION
  {
    # On a skipped assertion: no germline text, a somatic or oncogenicity one.
    ?cl a xyz:Classification .
    { SELECT DISTINCT ?cl WHERE {
        ?cl a xyz:Classification ; ?q2 ?sx . ?sx a ?sxt ; rdf:_1 ?sxtt .
        FILTER(?sxt IN (xyz:SomaticClinicalImpact, xyz:OncogenicityClassification) && isLiteral(?sxtt)) } }
    MINUS { ?cl ?q3 ?gx . ?gx a xyz:GermlineClassification ; rdf:_1 ?gxt . FILTER(isLiteral(?gxt)) }
    BIND("/Classification" AS ?sfT)
    BIND(clinvar:assertionNonGermlineClassification AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("skipped" AS ?gate)
  }
  UNION
  {
    # On a skipped assertion: no classification text of any kind.
    ?cl a xyz:Classification .
    MINUS { ?cl ?q4 ?ax . ?ax a ?axt ; rdf:_1 ?axtt .
            FILTER(?axt IN (xyz:GermlineClassification, xyz:SomaticClinicalImpact, xyz:OncogenicityClassification) && isLiteral(?axtt)) }
    BIND("/Classification" AS ?sfT)
    BIND(clinvar:assertionWithoutClassification AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("skipped" AS ?gate)
  }
  UNION
  {
    # Once per AttributeSet whose Attribute is an AssertionMethod, which the selector
    # names by position: AttributeSet is unbounded, so the predicate alone names a set.
    ?ca a xyz:ClinicalAssertion ; ?w1 ?aset . ?aset a xyz:AttributeSet ; ?w2 ?attr .
    ?attr a xyz:Attribute ; xyz:Type "AssertionMethod" .
    OPTIONAL { ?attr rdf:_1 ?attrT . FILTER(isLiteral(?attrT)) }
    { SELECT ?aset (COUNT(?earlierAs) AS ?beforeAs) WHERE {
        ?ownerAs ?sA ?aset . ?aset a xyz:AttributeSet .
        OPTIONAL { ?ownerAs ?sB ?earlierAs . ?earlierAs a xyz:AttributeSet .
                   FILTER(xsd:integer(STRAFTER(STR(?sB), "#_")) < xsd:integer(STRAFTER(STR(?sA), "#_"))) }
      } GROUP BY ?aset }
    BIND(CONCAT("/AttributeSet[", STR(?beforeAs + 1), "][Attribute/@Type='AssertionMethod']") AS ?sfT)
    BIND(clinvar:assertionMethodCriteria AS ?gap)
    BIND(?attrT AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("emitted" AS ?gate)
  }
  }
  FILTER(BOUND(?sfT))
  FILTER(?gate = "any" || (?gate = "emitted" && ?emitted) || (?gate = "skipped" && !?emitted))

  BIND(STRAFTER(STR(?recType), "http://sparql.xyz/facade-x/data/") AS ?recName)
  BIND(CONCAT(?recName, "/ClinicalAssertionList/ClinicalAssertion[ClinVarAccession/@Accession='", ?scv, "']", ?sfT) AS ?xpath)
}
