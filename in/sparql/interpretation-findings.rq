PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX clinvar: <https://ns.cascadeprotocol.org/adapter/clinvar/v1-draft#>

# Which rules fire depends on three facts about the RCV: a usable @Accession
# (?hasAcc), a non-empty GermlineClassification (?germ) and a canonical ACMG
# Description (?canon). A nested group cannot see them, so each rule binds a ?gate and
# one FILTER after the UNION applies it. Each also binds a path below its RCVAccession
# (?sfT); the record's wrapper element and the RCVAccession are joined on after the
# UNION.
#
# Shaped for Oxigraph's join ordering as variant.rq's header describes.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?xpath ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value ;
    sh:resultSeverity ?severity .
}
WHERE {
  ?va a xyz:VariationArchive ; ?recSlot ?rec .
  ?rec a ?recType .
  FILTER(?recType = xyz:ClassifiedRecord ||
         (?recType = xyz:IncludedRecord && NOT EXISTS { ?va ?cs ?cr . ?cr a xyz:ClassifiedRecord }))
  { SELECT DISTINCT ?rec WHERE { ?rec ?alSlot ?allele . ?allele a xyz:SimpleAllele } }
  ?rec ?s1 ?rcvl . ?rcvl a xyz:RCVList ; ?s2 ?rcv . ?rcv a xyz:RCVAccession .
  OPTIONAL { ?rcv xyz:Accession ?acc0 . FILTER(STRLEN(?acc0) > 0) }
  BIND(BOUND(?acc0) AS ?hasAcc)
  # An RCV with no usable @Accession is a finding of its own, so it anchors on its
  # position rather than dropping out of every rule and taking its other findings with
  # it. RCVList holds nothing but RCVAccession (schema/ClinVar_VCV_2.6.xsd:40), so the
  # container membership index is the XPath position and the selector still resolves to
  # exactly one node.
  BIND(IF(?hasAcc, CONCAT("[@Accession='", ?acc0, "']"),
                   CONCAT("[", STRAFTER(STR(?s2), "#_"), "]")) AS ?rcvSel)

  OPTIONAL {
    ?rcv ?f1 ?frc . ?frc a xyz:RCVClassifications ; ?f2 ?gc . ?gc a xyz:GermlineClassification .
    FILTER EXISTS { ?gc ?gp ?go FILTER(?gp != rdf:type) }
    OPTIONAL { ?gc ?f3 ?fd . ?fd a xyz:Description ; rdf:_1 ?fdt . FILTER(isLiteral(?fdt)) }
  }
  BIND(BOUND(?gc) AS ?germ)
  BIND(COALESCE(LCASE(REPLACE(?fdt, "^\\s+|\\s+$", "")) IN
         ("pathogenic", "likely pathogenic", "uncertain significance", "likely benign", "benign"), false) AS ?canon)

  OPTIONAL {
  {
    # An absence: the RCVAccession is the nearest element that exists, and ?rcvSel has
    # already selected it by position.
    BIND("" AS ?sfT)
    BIND(clinvar:rcvWithoutAccession AS ?gap)
    BIND(sh:Warning AS ?severity)
    BIND("noacc" AS ?gate)
  }
  UNION
  {
    # At most one of each per RCVClassifications (schema/ClinVar_VCV_2.6.xsd:1669, :1700).
    { SELECT DISTINCT ?rcv WHERE {
        ?rcv a xyz:RCVAccession ; ?r1 ?rc1 . ?rc1 a xyz:RCVClassifications ; ?r2 ?other .
        ?other a ?ot ; ?op ?oo .
        FILTER(?ot IN (xyz:SomaticClinicalImpact, xyz:OncogenicityClassification) && ?op != rdf:type) } }
    BIND("/RCVClassifications" AS ?sfT)
    BIND(clinvar:rcvNonGermlineClassification AS ?gap)
    BIND(sh:Info AS ?severity)
    BIND("any" AS ?gate)
  }
  UNION
  {
    # An absence: the RCVAccession is the nearest element that exists.
    BIND("" AS ?sfT)
    BIND(clinvar:rcvWithoutGermlineClassification AS ?gap)
    BIND(sh:Warning AS ?severity)
    BIND("nogerm" AS ?gate)
  }
  UNION
  {
    # An absence: the RCVAccession is the nearest element that exists.
    ?rcv a xyz:RCVAccession .
    MINUS { ?rcv ?r6 ?ccl6 . ?ccl6 a xyz:ClassifiedConditionList ; ?r7 ?cc6 . ?cc6 a xyz:ClassifiedCondition }
    BIND("" AS ?sfT)
    BIND(clinvar:rcvWithoutClassifiedCondition AS ?gap)
    BIND(sh:Warning AS ?severity)
    BIND("germ" AS ?gate)
  }
  UNION
  {
    # Only when the Description has text and there is a condition.
    ?rcv a xyz:RCVAccession ; ?r8 ?rc8 . ?rc8 a xyz:RCVClassifications ; ?r9 ?gc .
    ?gc a xyz:GermlineClassification ; ?r10 ?d8 . ?d8 a xyz:Description ; rdf:_1 ?d8t . FILTER(isLiteral(?d8t))
    { SELECT DISTINCT ?rcv WHERE {
        ?rcv a xyz:RCVAccession ; ?r11 ?ccl8 . ?ccl8 a xyz:ClassifiedConditionList ; ?r12 ?cc8 . ?cc8 a xyz:ClassifiedCondition } }
    BIND(REPLACE(?d8t, "^\\s+|\\s+$", "") AS ?acmgText)
    FILTER(STRLEN(?acmgText) > 0 && !(LCASE(?acmgText) IN
           ("pathogenic", "likely pathogenic", "uncertain significance", "likely benign", "benign")))
    BIND("/RCVClassifications/GermlineClassification/Description" AS ?sfT)
    BIND(clinvar:rcvClassificationOutsideAcmgSet AS ?gap)
    BIND(?acmgText AS ?value)
    BIND(sh:Warning AS ?severity)
    BIND("germ" AS ?gate)
  }
  UNION
  {
    # Per condition: the CUI itself, which is the identifier with no Cascade term.
    ?rcv a xyz:RCVAccession ; ?r17 ?ccl10 . ?ccl10 a xyz:ClassifiedConditionList ; ?s10 ?cc10 .
    ?cc10 a xyz:ClassifiedCondition ; xyz:DB "MedGen" ; xyz:ID ?id10 . FILTER(STRLEN(?id10) > 0)
    BIND(STRAFTER(STR(?s10), "#_") AS ?i10)
    BIND(CONCAT("/ClassifiedConditionList/ClassifiedCondition[", ?i10, "]/@ID") AS ?sfT)
    BIND(clinvar:medgenConceptIdentifier AS ?gap)
    BIND(?id10 AS ?value)
    BIND(sh:Info AS ?severity)
    BIND("canon" AS ?gate)
  }
  UNION
  {
    # A condition is what makes the review status worth reporting, so it gates the
    # rule rather than joining to it: the finding is about the one ReviewStatus node.
    ?rcv a xyz:RCVAccession ; ?r19 ?rc19 . ?rc19 a xyz:RCVClassifications ; ?r20 ?gc .
    ?gc a xyz:GermlineClassification ; ?r21 ?rs19 . ?rs19 a xyz:ReviewStatus ; rdf:_1 ?rst . FILTER(isLiteral(?rst))
    BIND(REPLACE(?rst, "^\\s+|\\s+$", "") AS ?rsText)
    FILTER(STRLEN(?rsText) > 0 && !(LCASE(?rsText) IN (
      "no assertion provided", "no assertion criteria provided", "criteria provided, single submitter",
      "criteria provided, conflicting interpretations", "criteria provided, conflicting classifications",
      "criteria provided, conflicting classifications of pathogenicity",
      "criteria provided, multiple submitters, no conflicts", "reviewed by expert panel", "practice guideline")))
    FILTER EXISTS { ?rcv ?r22 ?ccl19 . ?ccl19 a xyz:ClassifiedConditionList ; ?r23 ?cc19 . ?cc19 a xyz:ClassifiedCondition }
    BIND("/RCVClassifications/GermlineClassification/ReviewStatus" AS ?sfT)
    BIND(clinvar:rcvReviewStatusOutsideTiers AS ?gap)
    BIND(?rsText AS ?value)
    BIND(sh:Warning AS ?severity)
    BIND("canon" AS ?gate)
  }
  }
  FILTER(BOUND(?sfT))
  FILTER(?gate = "any" || (?gate = "noacc" && !?hasAcc) || (?gate = "nogerm" && !?germ) ||
         (?gate = "germ" && ?germ) || (?gate = "canon" && ?germ && ?canon))

  BIND(STRAFTER(STR(?recType), "http://sparql.xyz/facade-x/data/") AS ?recName)
  BIND(CONCAT(?recName, "/RCVList/RCVAccession", ?rcvSel, ?sfT) AS ?xpath)
}
