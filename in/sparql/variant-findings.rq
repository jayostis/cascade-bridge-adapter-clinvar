PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX clinvar: <https://ns.cascadeprotocol.org/adapter/clinvar/v1-draft#>

# A nested group cannot see variables bound outside it, so each branch binds a
# path below the record's wrapper element (?sfT) and the wrapper's own name is
# joined on after the UNION.
#
# ?selector stays unbound for a finding about the whole record, and ?value for a
# rule that read no source value; the template's triples drop with them.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector ?selector
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value ;
    sh:resultSeverity ?severity .
  ?selector a oa:XPathSelector ; rdf:value ?xpath .
}
WHERE {
  {
  ?va a xyz:VariationArchive ; ?recSlot ?rec .
  ?rec a ?recType .
  FILTER(?recType = xyz:ClassifiedRecord ||
         (?recType = xyz:IncludedRecord && NOT EXISTS { ?va ?cs ?cr . ?cr a xyz:ClassifiedRecord }))
  ?rec ?saSlot ?sa . ?sa a xyz:SimpleAllele .
  OPTIONAL {
  {
    ?anchorRec a ?anchorType ; ?anchorSlot ?sa . FILTER(?anchorType IN (xyz:ClassifiedRecord, xyz:IncludedRecord)) ?sa a xyz:SimpleAllele .
    MINUS { ?sa ?x1 ?gl . ?gl a xyz:GeneList ; ?x2 ?gn . ?gn a xyz:Gene }
    BIND("/SimpleAllele" AS ?sfT)
    BIND(clinvar:simpleAlleleWithoutGene AS ?gap)
    BIND(sh:Warning AS ?severity)
  }
  UNION
  {
    { SELECT ?sa (COUNT(?gn) AS ?n) WHERE {
        ?anchorRec a ?anchorType ; ?anchorSlot ?sa . FILTER(?anchorType IN (xyz:ClassifiedRecord, xyz:IncludedRecord)) ?sa a xyz:SimpleAllele ; ?x1 ?gl . ?gl a xyz:GeneList ; ?x2 ?gn . ?gn a xyz:Gene
      } GROUP BY ?sa }
    FILTER(?n > 1)
    BIND("/SimpleAllele/GeneList" AS ?sfT)
    BIND(clinvar:multipleGenesOnlyFirstCarried AS ?gap)
    BIND(sh:Warning AS ?severity)
  }
  UNION
  {
    # A ProteinChange with no p. expression the Variant could carry: the ones counted
    # are variant.rq's hgvsPDot candidates, and the two rules change together. Counted
    # once per SimpleAllele: a FILTER NOT EXISTS re-walks the HGVS list for every row.
    { SELECT ?sa (COUNT(DISTINCT ?pc) AS ?nPc) WHERE {
        ?anchorRec a ?anchorType ; ?anchorSlot ?sa . FILTER(?anchorType IN (xyz:ClassifiedRecord, xyz:IncludedRecord)) ?sa a xyz:SimpleAllele ; ?x1 ?pc . ?pc a xyz:ProteinChange
      } GROUP BY ?sa }
    OPTIONAL { SELECT ?sa (COUNT(?t) AS ?nP) WHERE {
        ?anchorRec a ?anchorType ; ?anchorSlot ?sa . FILTER(?anchorType IN (xyz:ClassifiedRecord, xyz:IncludedRecord)) ?sa a xyz:SimpleAllele ; ?y1 ?hl . ?hl a xyz:HGVSlist ; ?y2 ?hv . ?hv a xyz:HGVS ; xyz:Type ?type ; ?y3 ?pe .
        ?pe a xyz:ProteinExpression ; ?y4 ?ex . ?ex a xyz:Expression ; rdf:_1 ?t .
        FILTER(CONTAINS(?t, ":p.") && (?type = "coding" || ?type = "protein"))
        MINUS { ?hv xyz:Type "protein" ; ?y5 ?ne . ?ne a xyz:NucleotideExpression }
      } GROUP BY ?sa }
    FILTER(?nPc > 0 && COALESCE(?nP, 0) = 0)
    BIND("/SimpleAllele" AS ?sfT)
    BIND(clinvar:proteinChangeWithoutHgvsProtein AS ?gap)
    BIND(sh:Info AS ?severity)
  }
  }
  FILTER(BOUND(?sfT))
  }
  UNION
  {
    # A record holding a Haplotype or a Genotype and no SimpleAllele: no query writes
    # anything else for it, so this finding is all that records it was seen. It is
    # about the record itself, so it carries no selector of its own.
    ?va a xyz:VariationArchive ; ?recSlot ?rec .
    ?rec a ?recType .
    FILTER(?recType = xyz:ClassifiedRecord ||
           (?recType = xyz:IncludedRecord && NOT EXISTS { ?va ?cs ?cr . ?cr a xyz:ClassifiedRecord }))
    FILTER NOT EXISTS { ?rec ?saSlot ?sa . ?sa a xyz:SimpleAllele }
    BIND(clinvar:haplotypeOrGenotypeRecordOnly AS ?gap)
    BIND(sh:Warning AS ?severity)
  }

  BIND(STRAFTER(STR(?recType), "http://sparql.xyz/facade-x/data/") AS ?recName)
  BIND(IF(BOUND(?sfT), CONCAT(?recName, ?sfT), 1/0) AS ?xpath)
  BIND(IF(BOUND(?xpath), BNODE(), 1/0) AS ?selector)
}
