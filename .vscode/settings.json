{
  // Every fixture input validates live against the pinned NCBI schema. The
  // association points at the envelope wrapper, which includes NCBI's XSD and
  // adds the one root element (ClinVarResult-Set) that NCBI's schema does not
  // declare; see schema/ClinVarResult-Set.xsd.
  "xml.fileAssociations": [
    {
      "pattern": "**/fixtures/in/*.xml",
      "systemId": "${workspaceFolder}/schema/ClinVarResult-Set.xsd"
    }
  ],
  "xml.validation.enabled": true,
  // The adapter manifest is ro-crate-metadata.json (JSON-LD) and the test
  // manifest is fixtures/manifest.ttl (Turtle); both are validated by SHACL,
  // against shapes that live in the Cascade Bridge Specification rather than
  // in this repository, and the crate by the RO-Crate validator. Neither is a
  // JSON Schema, so there is no schema association here.
  // .github/workflows/validate.yml runs both on every pull request.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Digested files (see .editorconfig): no save-time rewriting. A language
  // override reaches every file in that language, so only languages whose
  // files are digested (or nearly all are) get one. Every digested file is XML,
  // Turtle or SPARQL, so the three overrides below reach all of them, and the
  // crate, which is JSON and carries no digest, keeps the defaults above.
  "[xml]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[turtle]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[sparql]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  }
}
