@prefix bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix clinvar: <https://ns.cascadeprotocol.org/adapter/clinvar/v1-draft#> .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@Accession" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@DateCreated" ;
  bridge:verdict bridge:ignored ;
  bridge:because "When ClinVar first built the aggregate record, which dates the record rather than the variation." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@DateLastUpdated" ;
  bridge:verdict bridge:ignored ;
  bridge:because "When ClinVar last rebuilt the aggregate record, which dates the record rather than the variation." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@MostRecentSubmission" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's own release bookkeeping, not a fact about the variation." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@NumberOfSubmissions" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateNumberOfSubmissions .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@NumberOfSubmitters" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateNumberOfSubmitters .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@RecordType" ;
  bridge:verdict bridge:redundantWith ;
  bridge:sameFactAs "/VariationArchive/ClassifiedRecord" .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@VariationID" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@VariationName" ;
  bridge:verdict bridge:redundantWith ;
  bridge:sameFactAs "/VariationArchive/ClassifiedRecord/SimpleAllele/HGVSlist/HGVS/NucleotideExpression/Expression" .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@VariationType" ;
  bridge:verdict bridge:redundantWith ;
  bridge:sameFactAs "/VariationArchive/ClassifiedRecord/SimpleAllele/VariantType" .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/@Version" ;
  bridge:verdict bridge:ignored ;
  bridge:because "A counter ClinVar bumps on any change to the record, with no meaning outside ClinVar's own versioning." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/@DateCreated" ;
  bridge:verdict bridge:ignored ;
  bridge:because "When ClinVar first built the aggregate roll-up, which dates the roll-up rather than any classification in it." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/@DateLastEvaluated" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The date of ClinVar's roll-up across submissions; the graph carries each RCV's own evaluation date instead." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/@MostRecentSubmission" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's own release bookkeeping, not a fact about the classification." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/@NumberOfSubmissions" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateNumberOfSubmissions .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/@NumberOfSubmitters" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateNumberOfSubmitters .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation/@Abbrev" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation/@Type" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation/ID" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation/ID/@Source" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Citation/URL" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/@ContributesToAggregateClassification" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Which trait sets ClinVar folded into the roll-up; the graph carries each RCV on its own and folds nothing." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/@ID" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's kind of trait set; the graph makes no distinction between kinds of condition." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/@ID" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's internal number for the trait; the graph names a condition by its MONDO or MedGen identifier." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's kind of trait; the graph makes no distinction between kinds of condition." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet" ;
  bridge:verdict bridge:ignored ;
  bridge:because "MedGen's prose about the condition: its public definition, its inheritance and its GARD number. The graph names a condition by identifier and describes it nowhere." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/Attribute" ;
  bridge:verdict bridge:ignored ;
  bridge:because "MedGen's prose about the condition: its public definition, its inheritance and its GARD number. The graph names a condition by identifier and describes it nowhere." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/Attribute/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "MedGen's prose about the condition: its public definition, its inheritance and its GARD number. The graph names a condition by identifier and describes it nowhere." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/Attribute/@integerValue" ;
  bridge:verdict bridge:ignored ;
  bridge:because "MedGen's prose about the condition: its public definition, its inheritance and its GARD number. The graph names a condition by identifier and describes it nowhere." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/XRef" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Where the condition's definition text came from; the graph carries neither the text nor its source." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/XRef/@DB" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Where the condition's definition text came from; the graph carries neither the text nor its source." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/AttributeSet/XRef/@ID" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The identifier of the condition's definition text at its source; the graph carries neither." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/@Abbrev" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/@Type" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/CitationText" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/ID" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/ID/@Source" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Citation/URL" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap clinvar:aggregateClassificationCitation .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/ElementValue" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The condition's display name; the graph names a condition by its MONDO or MedGen identifier and carries no label." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/ElementValue/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Which of a condition's names ClinVar prefers; the graph carries none of them." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/XRef" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/XRef/@DB" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/XRef/@ID" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Name/XRef/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "How a cross-reference stands to the name it hangs on; the graph carries the identifier alone." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The condition's abbreviation; the graph names a condition by its MONDO or MedGen identifier and carries no label." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/ElementValue" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The condition's abbreviation; the graph names a condition by its MONDO or MedGen identifier and carries no label." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/ElementValue/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Which of a condition's abbreviations ClinVar prefers; the graph carries none of them." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/XRef" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Where the condition's abbreviation came from; the graph carries neither the abbreviation nor its source." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/XRef/@DB" ;
  bridge:verdict bridge:ignored ;
  bridge:because "Where the condition's abbreviation came from; the graph carries neither the abbreviation nor its source." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/XRef/@ID" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The identifier of the condition's abbreviation at its source; the graph carries neither." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/Symbol/XRef/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "How a cross-reference stands to the abbreviation it hangs on; the graph carries neither." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/XRef" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/XRef/@DB" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/XRef/@ID" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ConditionList/TraitSet/Trait/XRef/@Type" ;
  bridge:verdict bridge:ignored ;
  bridge:because "How a cross-reference stands to the trait it hangs on; the graph carries the identifier alone." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/Description" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's roll-up of the submitted classifications; the graph carries each RCV's classification, from which the roll-up is ClinVar's own summary." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/Classifications/GermlineClassification/ReviewStatus" ;
  bridge:verdict bridge:ignored ;
  bridge:because "ClinVar's roll-up of the submitted review statuses; the graph carries each RCV's review status instead." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/ClinicalAssertionList" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/ClinicalAssertionList/ClinicalAssertion" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/ClinicalAssertionList/ClinicalAssertion/@ContributesToAggregateClassification" ;
