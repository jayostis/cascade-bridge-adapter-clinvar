[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/ClinicalAssertionList/ClinicalAssertion/AdditionalSubmitters" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The organizations that co-submitted the assertion; the graph carries the one submitter the accession names." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/VariationArchive/ClassifiedRecord/ClinicalAssertionList/ClinicalAssertion/AdditionalSubmitters/SubmitterDescription" ;
  bridge:verdict bridge:ignored ;
  bridge:because "The organizations that co-submitted the assertion; the graph carries the one submitter the accession names." .

[] a bridge:PathEntry ;
