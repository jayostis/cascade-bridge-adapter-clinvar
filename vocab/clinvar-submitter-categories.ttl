@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix genomics: <https://ns.cascadeprotocol.org/genomics/v1#> .
@prefix clinvar:  <https://ns.cascadeprotocol.org/adapter/clinvar/v1-draft#> .

clinvar:submitterCategories a skos:ConceptScheme ;
  skos:prefLabel "ClinVar submitting organization categories"@en .

clinvar:submitterCategoryLaboratory a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "laboratory" ;
  skos:exactMatch genomics:SubmitterLaboratory .

clinvar:submitterCategoryConsortium a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "consortium" ;
  skos:exactMatch genomics:SubmitterConsortium .

clinvar:submitterCategoryExpertPanelHyphenated a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "expert-panel" ;
  skos:exactMatch genomics:SubmitterExpertPanel .

clinvar:submitterCategoryExpertPanel a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "expert panel" ;
  skos:exactMatch genomics:SubmitterExpertPanel .

clinvar:submitterCategoryResearchGroup a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "research group" ;
  skos:exactMatch genomics:SubmitterResearch .

clinvar:submitterCategoryResearch a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "research" ;
  skos:exactMatch genomics:SubmitterResearch .

clinvar:submitterCategoryResource a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "resource" ;
  skos:closeMatch genomics:SubmitterLaboratory .

clinvar:submitterCategoryClinician a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "clinician" ;
  skos:closeMatch genomics:SubmitterClinician .

clinvar:submitterCategorySingleClinician a skos:Concept ;
  skos:inScheme clinvar:submitterCategories ;
  skos:notation "single clinician" ;
  skos:closeMatch genomics:SubmitterClinician .
